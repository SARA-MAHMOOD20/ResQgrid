# File:       .gitignore
# Owner:      Sara
# Purpose:    Keep build products, logs and editor files out of git.
# Depends on: -
# Used by:    git
# Milestone:  M0

# Development plan: private to the team, NEVER commit it (any folder, any copy)
*Development_Plan*
*development_plan*

# Build folders
build/
build-*/
cmake-build-*/
out/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
Testing/

# Compiled files
*.o
*.obj
*.a
*.lib
*.exe
*.out
*.pdb
*.ilk

# Simulation output: logs are written here but not committed
output/*
!output/.gitkeep

# Editors / OS
.vscode/
.idea/
.vs/
*.swp
*~
.DS_Store
Thumbs.db

# LaTeX build files
*.aux
*.log
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls
